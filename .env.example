# =================================================================
# WEEX SETUP 11 TRADING BOT - ENVIRONMENT CONFIGURATION
# =================================================================

# 1. WEEX API CREDENTIALS (from WEEX API Management)
WEEX_API_KEY=your_weex_api_key_here
WEEX_SECRET_KEY=your_weex_secret_key_here
WEEX_PASSPHRASE=your_weex_passphrase_here

# 2. TRADING EXECUTION MODE
# Set to 'true' for paper trading (no real capital risked)
# Set to 'false' for live real-money order placement
WEEX_DRY_RUN=true

# 3. RISK MANAGEMENT & SIZING RULES
# Exact maximum dollar risk per trade (strictly enforced)
MAX_RISK_USD=1.0

# Native exchange hard stop loss distance (% below entry)
STOP_LOSS_PCT=8.0

# 4. MOMENTUM SELECTION FILTER
# Minimum prior-calendar-day (00:00-23:45 UTC) gain percentage
MIN_PRIOR_DAY_GAIN_PCT=10.0

# Maximum number of top leaders to trade per day
MAX_CANDIDATES=5

# 5. EXECUTION WINDOW (UTC)
SCAN_TIME_UTC=07:55
ENTRY_TIME_UTC=08:00
EXIT_TIME_UTC=20:00

# 6. TELEGRAM NOTIFICATIONS
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Find your numeric ID via @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

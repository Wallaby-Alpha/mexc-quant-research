[Unit]
Description=WEEX Setup 11 London Dip Momentum Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/mexc-quant-research
ExecStart=/root/mexc-quant-research/venv/bin/python bot/weex_london_dip_bot.py
Restart=always
RestartSec=15
StandardOutput=append:/root/mexc-quant-research/weex_london_dip.log
StandardError=append:/root/mexc-quant-research/weex_london_dip.log

[Install]
WantedBy=multi-user.target
